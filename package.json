{
  "name": "language-plugin-dsh",
  "version": "0.1.0",
  "description": "Chat language picker with artifacts pinned to en-US: reply in the user language, English code and docs, plugin-only.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "language",
    "i18n",
    "cordis"
  ],
  "author": "Fabricio Archanjo <farchanjo@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./compaction": "./lib/compaction.js"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "biome.json",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "biome check lib test",
    "lint:fix": "biome check --write lib test"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farchanjo/language-plugin-dsh.git"
  },
  "homepage": "https://github.com/farchanjo/language-plugin-dsh#readme",
  "bugs": {
    "url": "https://github.com/farchanjo/language-plugin-dsh/issues"
  },
  "dependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2"
  }
}
